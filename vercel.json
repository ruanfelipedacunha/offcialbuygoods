{
  "rewrites": [
    {
      "source": "/api/buygoods/(.*)",
      "destination": "https://api.buygoods.com/affiliates/api/v1/$1"
    },
    {
      "source": "/api/clickcrm/(.*)",
      "destination": "https://api.clickcrm.com/affiliates/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
